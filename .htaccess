# Business Bridge Egypt — bbegypt.com
DirectoryIndex index.html

# Always use the secure address (Let's Encrypt certificate) and the bare domain
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://bbegypt.com%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.bbegypt\.com$ [NC]
  RewriteRule ^ https://bbegypt.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/javascript .js
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching: hashed build assets and textures are immutable, the HTML always revalidates
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
